# .agents/bot.env — non-secret git/worktree settings for SpySWAT bot wrappers
# Keep public-repo safe: do not put API keys or personal machine paths here.
PROJECT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
BASE_BRANCH=main
WT_DIR=.wt
MANAGER=codex-mgr
RUNTIME_DIR=.agents/.runtime
RUNTIME_TTL_DAYS=7
GITNEXUS_SYNC=none          # none | main | worktree
